# BIMGuard — LLM (optional, explanation layer only)
# Deterministic checks work without any key. Live LLM requires one of:
OPENAI_API_KEY=your_key_here
# or
# LLM_API_KEY=your_key_here

OPENAI_BASE_URL=https://api.openai.com/v1
# or
# LLM_BASE_URL=https://api.openai.com/v1

LLM_MODEL=your_model
# e.g. gpt-4o-mini, gpt-4o, or any OpenAI-compatible model

# Backend
PORT=8000

# Strict live validation (no silent fallback) — for backend/scripts/live_llm_smoke.py
# LLM_STRICT=1
